#!/usr/bin/env bash
set -euo pipefail

ACTION="${1:-status}"
ENV_FILE="${FAKENET_ENV_FILE:-/etc/fakenet-billing.env}"

BILLING_UNITS=(
  fakenet-billing.service
  fakenet-billing-isolir.service
  fakenet-billing-voucher.service
  fakenet-billing-wifiku.service
  fakenet-billing-radius-connector.service
  fakenet-billing-waha.service
)

GENIEACS_UNITS=(
  fakenet-billing-genieacs-mongodb.service
  fakenet-billing-genieacs-cwmp.service
  fakenet-billing-genieacs-nbi.service
  fakenet-billing-genieacs-fs.service
  fakenet-billing-genieacs-ui.service
)

BILLING_SERVICES=(
  fakenet-billing
  fakenet-billing-isolir
  fakenet-billing-voucher
  fakenet-billing-wifiku
  fakenet-billing-radius-connector
  fakenet-billing-waha
)

GENIEACS_SERVICES=(
  fakenet-billing-genieacs-mongodb
  fakenet-billing-genieacs-cwmp
  fakenet-billing-genieacs-nbi
  fakenet-billing-genieacs-fs
  fakenet-billing-genieacs-ui
)

SYSTEMD_BASE_GROUPS=(
  "redis-server.service redis.service"
  "postgresql.service postgresql@15-main.service postgresql@14-main.service postgresql@13-main.service"
  "freeradius.service radiusd.service"
  "docker.service"
)

OPENRC_BASE_SERVICES=(redis postgresql freeradius radiusd docker)
UPDATE_LOCK_FILE="${FAKENET_UPDATE_LOCK:-/tmp/fakenet-billing-update.lock}"

clear_stale_update_lock() {
  local pid command
  [ -e "$UPDATE_LOCK_FILE" ] || {
    echo "Lock update tidak ada."
    return 0
  }
  pid="$(cat "$UPDATE_LOCK_FILE" 2>/dev/null || true)"
  command=""
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    command="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
  fi
  if printf '%s' "$command" | grep -q 'fakenet-billing-update'; then
    echo "Update masih aktif pada PID $pid; lock tidak dihapus." >&2
    return 1
  fi
  rm -f "$UPDATE_LOCK_FILE"
  echo "Lock update stale sudah dihapus: $UPDATE_LOCK_FILE"
}

systemd_unit_exists() {
  systemctl list-unit-files "$1" --no-legend >/dev/null 2>&1
}

bundled_genieacs_enabled() {
  local bundled=""
  if [ -f "$ENV_FILE" ]; then
    bundled="$(grep -E '^FAKENET_BUNDLED_GENIEACS=' "$ENV_FILE" 2>/dev/null | tail -n1 | cut -d= -f2- | tr -d '\"' || true)"
  fi
  [ "$bundled" = "1" ]
}

resolve_systemd_group() {
  local unit
  for unit in "$@"; do
    if systemd_unit_exists "$unit"; then
      printf '%s\n' "$unit"
      return 0
    fi
  done
  return 1
}

systemd_base_units() {
  local group unit
  for group in "${SYSTEMD_BASE_GROUPS[@]}"; do
    unit="$(resolve_systemd_group $group || true)"
    [ -n "$unit" ] && printf '%s\n' "$unit"
  done
}

systemd_units() {
  local unit
  systemd_base_units
  for unit in "${BILLING_UNITS[@]}"; do
    systemd_unit_exists "$unit" && printf '%s\n' "$unit"
  done
  if bundled_genieacs_enabled; then
    for unit in "${GENIEACS_UNITS[@]}"; do
      systemd_unit_exists "$unit" && printf '%s\n' "$unit"
    done
  fi
}

systemd_app_units() {
  local unit
  for unit in "${BILLING_UNITS[@]}"; do
    systemd_unit_exists "$unit" && printf '%s\n' "$unit"
  done
  if bundled_genieacs_enabled; then
    for unit in "${GENIEACS_UNITS[@]}"; do
      systemd_unit_exists "$unit" && printf '%s\n' "$unit"
    done
  fi
}

restart_unit() {
  local unit="$1"
  if systemctl restart "$unit"; then
    return 0
  fi
  systemctl start "$unit" || true
  systemctl is-active --quiet "$unit"
}

openrc_service_exists() {
  [ -x "/etc/init.d/$1" ]
}

openrc_services() {
  local service
  for service in "${OPENRC_BASE_SERVICES[@]}" "${BILLING_SERVICES[@]}"; do
    openrc_service_exists "$service" && printf '%s\n' "$service"
  done
  if bundled_genieacs_enabled; then
    for service in "${GENIEACS_SERVICES[@]}"; do
      openrc_service_exists "$service" && printf '%s\n' "$service"
    done
  fi
}

openrc_app_services() {
  local service
  for service in "${BILLING_SERVICES[@]}"; do
    openrc_service_exists "$service" && printf '%s\n' "$service"
  done
  if bundled_genieacs_enabled; then
    for service in "${GENIEACS_SERVICES[@]}"; do
      openrc_service_exists "$service" && printf '%s\n' "$service"
    done
  fi
}

run_systemd() {
  mapfile -t units < <(systemd_units)
  case "$ACTION" in
    start)
      systemctl start "${units[@]}"
      ;;
    restart)
      failed=0
      for unit in "${units[@]}"; do
        restart_unit "$unit" || failed=1
      done
      return "$failed"
      ;;
    restart-app)
      failed=0
      mapfile -t units < <(systemd_app_units)
      for unit in "${units[@]}"; do
        restart_unit "$unit" || failed=1
      done
      return "$failed"
      ;;
    stop)
      mapfile -t units < <(systemd_app_units)
      for unit in "${units[@]}"; do
        systemctl stop "$unit" || true
      done
      ;;
    status)
      systemctl status "${units[@]}" --no-pager
      ;;
    update)
      /usr/local/bin/fakenet-billing-update
      ;;
    clear-update-lock)
      clear_stale_update_lock
      ;;
    *)
      echo "Usage: fakenet-billing-stack {start|restart|restart-app|stop|status|update|clear-update-lock}" >&2
      exit 2
      ;;
  esac
}

run_openrc() {
  mapfile -t services < <(openrc_services)
  case "$ACTION" in
    start)
      for service in "${services[@]}"; do rc-service "$service" start || true; done
      ;;
    restart)
      failed=0
      for service in "${services[@]}"; do
        rc-service "$service" restart || rc-service "$service" start || failed=1
      done
      return "$failed"
      ;;
    restart-app)
      failed=0
      mapfile -t services < <(openrc_app_services)
      for service in "${services[@]}"; do
        rc-service "$service" restart || rc-service "$service" start || failed=1
      done
      return "$failed"
      ;;
    stop)
      mapfile -t services < <(openrc_app_services)
      for service in "${services[@]}"; do rc-service "$service" stop || true; done
      ;;
    status)
      for service in "${services[@]}"; do rc-service "$service" status || true; done
      ;;
    update)
      /usr/local/bin/fakenet-billing-update
      ;;
    clear-update-lock)
      clear_stale_update_lock
      ;;
    *)
      echo "Usage: fakenet-billing-stack {start|restart|restart-app|stop|status|update|clear-update-lock}" >&2
      exit 2
      ;;
  esac
}

if command -v systemctl >/dev/null 2>&1; then
  run_systemd
elif command -v rc-service >/dev/null 2>&1; then
  run_openrc
else
  echo "Service manager tidak dikenali." >&2
  exit 1
fi
