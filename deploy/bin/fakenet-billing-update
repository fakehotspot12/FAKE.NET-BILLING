#!/usr/bin/env bash
set -euo pipefail
umask 077

if ! ( . /etc/os-release; { [ "$ID" = ubuntu ] && [ "$VERSION_ID" = 24.04 ]; } || { [ "$ID" = debian ] && [ "$VERSION_ID" = 12 ]; } ); then
  echo "ERROR: update hanya mendukung Ubuntu 24.04 LTS atau Debian 12." >&2
  exit 1
fi

APP_DIR="${APP_DIR:-/opt/fakenet-billing}"
BACKUP_DIR="${FAKENET_BACKUP_DIR:-/var/backups/fakenet-billing}"
LOG_DIR="${FAKENET_LOG_DIR:-/var/log/fakenet-billing}"
LOG_FILE="${FAKENET_UPDATE_LOG:-$LOG_DIR/update.log}"
LOCK_FILE="${FAKENET_UPDATE_LOCK:-/tmp/fakenet-billing-update.lock}"
LOCK_MAX_AGE_SECONDS="${FAKENET_UPDATE_LOCK_MAX_AGE_SECONDS:-3600}"
NPM_INSTALL_TIMEOUT_SECONDS="${FAKENET_NPM_INSTALL_TIMEOUT_SECONDS:-600}"
STACK_CMD="${FAKENET_STACK_CMD:-/usr/local/bin/fakenet-billing-stack}"
ARCHIVE_URL="${FAKENET_UPDATE_ARCHIVE_URL:-}"
BRANCH="${FAKENET_UPDATE_BRANCH:-}"
ARCHIVE_URL_OVERRIDE="$ARCHIVE_URL"
BRANCH_OVERRIDE="$BRANCH"
DOWNLOAD_TIMEOUT_SECONDS="${FAKENET_UPDATE_DOWNLOAD_TIMEOUT_SECONDS:-900}"
DOWNLOAD_RETRIES="${FAKENET_UPDATE_DOWNLOAD_RETRIES:-4}"
ENV_FILE="${FAKENET_ENV_FILE:-/etc/fakenet-billing.env}"
WAHA_ENV_FILE="${FAKENET_WAHA_ENV_FILE:-/etc/fakenet-billing-waha.env}"
TURNSTILE_ENV_FILE="/etc/fakenet-billing-turnstile.env"
ISOLIR_CONTEXT_ENV_FILE="/etc/fakenet-billing-isolir-context.env"
GENIEACS_ENV_FILE="${FAKENET_GENIEACS_ENV_FILE:-/etc/fakenet-billing-genieacs.env}"

mkdir -p "$BACKUP_DIR" "$LOG_DIR"
chmod 700 "$BACKUP_DIR" "$LOG_DIR" 2>/dev/null || true
touch "$LOG_FILE"
chmod 600 "$LOG_FILE" 2>/dev/null || true
exec > >(
  awk '{
    print "[" strftime("%Y-%m-%d %H:%M:%S %z") "] " $0;
    fflush();
  }' >>"$LOG_FILE"
) 2>&1

echo
echo "Update dimulai"

lock_age_seconds() {
  local modified now
  modified="$(stat -c %Y "$LOCK_FILE" 2>/dev/null || echo 0)"
  now="$(date +%s)"
  if [ "$modified" -gt 0 ] 2>/dev/null; then
    echo $((now - modified))
  else
    echo "$LOCK_MAX_AGE_SECONDS"
  fi
}

lock_process_is_updater() {
  local pid="$1" command
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || return 1
  command="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
  printf '%s' "$command" | grep -q 'fakenet-billing-update'
}

acquire_update_lock() {
  local attempt lock_pid lock_age
  for attempt in 1 2 3; do
    if (set -o noclobber; printf '%s\n' "$$" > "$LOCK_FILE") 2>/dev/null; then
      return 0
    fi
    lock_pid="$(cat "$LOCK_FILE" 2>/dev/null || true)"
    lock_age="$(lock_age_seconds)"
    if lock_process_is_updater "$lock_pid"; then
      echo "Update lain masih berjalan: $LOCK_FILE (pid $lock_pid)"
      return 1
    fi
    echo "Lock update stale ditemukan dan dibersihkan: $LOCK_FILE (pid ${lock_pid:-tidak-valid}, umur ${lock_age}s)"
    rm -f "$LOCK_FILE"
  done
  echo "Lock update tidak bisa dibuat: $LOCK_FILE" >&2
  return 1
}

release_update_lock() {
  local lock_pid
  lock_pid="$(cat "$LOCK_FILE" 2>/dev/null || true)"
  if [ "$lock_pid" = "$$" ]; then
    rm -f "$LOCK_FILE"
  fi
}

tmp_backup_dir=""
tmpdir=""
dependency_stage=""
source_stage=""
rollback_dir=""
activation_started=0
queue_state=""
active_units=()
cleanup_update() {
  local status=$? keep_stage=0
  if [ "$status" -ne 0 ] && [ "$activation_started" = 1 ]; then
    echo "Aktivasi gagal; memulihkan source dan dependency. Database transaksi tidak ditimpa."
    systemctl stop "${active_units[@]}" || true
    if [ ! -f "$rollback_dir/activation.json" ]; then
      echo "Aktivasi belum mengubah source; menjalankan kembali service lama."
      [ "${#active_units[@]}" -eq 0 ] || systemctl start "${active_units[@]}" || true
    elif node "$source_stage/deploy/activate-release.js" rollback "$APP_DIR" "$rollback_dir"; then
      if [ -d "$rollback_dir/systemd" ]; then
        for unit in "$rollback_dir/systemd/"*; do [ ! -f "$unit" ] || cp -a "$unit" /etc/systemd/system/; done
      fi
      for command in fakenet-billing-update fakenet-billing-stack; do
        [ ! -f "$APP_DIR/deploy/bin/$command" ] || install -m 0755 "$APP_DIR/deploy/bin/$command" "/usr/local/bin/$command"
      done
      systemctl daemon-reload || true
      [ "${#active_units[@]}" -eq 0 ] || systemctl start "${active_units[@]}" || true
      echo "Kode/dependency lama dipulihkan. Periksa log sebelum mengulangi update."
    else
      keep_stage=1
      echo "ERROR: rollback belum lengkap. Backup tetap tersedia: $rollback_dir" >&2
      echo "Helper pemulihan tetap tersedia: $source_stage/deploy/activate-release.js" >&2
    fi
  elif [ "$status" -ne 0 ] && [ "${#active_units[@]}" -gt 0 ]; then
    systemctl start "${active_units[@]}" || true
  fi
  if [ -n "$queue_state" ] && [ -f "$queue_state" ]; then
    node "$source_stage/deploy/queue-guard.js" resume "$APP_DIR" "$queue_state" || echo "ERROR: periksa pemulihan antrean WA secara manual." >&2
  fi
  release_update_lock
  if [ -n "$tmp_backup_dir" ]; then
    rm -rf "$tmp_backup_dir"
  fi
  if [ -n "$tmpdir" ] && [ "$keep_stage" = 0 ]; then
    rm -rf "$tmpdir"
  fi
  if [ -n "$dependency_stage" ] && [ "$keep_stage" = 0 ]; then
    rm -rf "$dependency_stage"
  fi
  return 0
}

acquire_update_lock
trap cleanup_update EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if [ ! -d "$APP_DIR" ]; then
  echo "APP_DIR tidak ditemukan: $APP_DIR"
  exit 1
fi

normalize_spaced_env_value() {
  local key="$1" line value escaped
  line="$(grep -m1 "^${key}=" "$ENV_FILE" 2>/dev/null || true)"
  [ -n "$line" ] || return 0
  value="${line#*=}"
  case "$value" in
    \"*\"|\'*\') return 0 ;;
  esac
  [[ "$value" =~ [[:space:]] ]] || return 0
  escaped="${value//\\/\\\\}"
  escaped="${escaped//\"/\\\"}"
  escaped="${escaped//\$/\\\$}"
  escaped="${escaped//\`/\\\`}"
  escaped="${escaped//|/\\|}"
  sed -i "s|^${key}=.*$|${key}=\"${escaped}\"|" "$ENV_FILE"
  echo "Format $key lama dinormalisasi agar aman dibaca updater."
}

load_env_file() {
  if [ -f "$ENV_FILE" ]; then
    normalize_spaced_env_value APP_ADMIN_NAME
    set -a
    # shellcheck disable=SC1090
    . "$ENV_FILE"
    set +a
  fi
}

harden_sensitive_permissions() {
  local file
  for file in "$ENV_FILE" "$WAHA_ENV_FILE" "$GENIEACS_ENV_FILE" "$TURNSTILE_ENV_FILE" "$ISOLIR_CONTEXT_ENV_FILE"; do
    [ ! -f "$file" ] || chmod 600 "$file"
  done
  if [ -d "$APP_DIR/data" ]; then
    find "$APP_DIR/data" -type d -exec chmod 700 {} + 2>/dev/null || true
    find "$APP_DIR/data" -type f -exec chmod 600 {} + 2>/dev/null || true
  fi
  find "$BACKUP_DIR" -maxdepth 1 -type f -exec chmod 600 {} + 2>/dev/null || true
}

port_is_listening() {
  local port="$1"
  if command -v ss >/dev/null 2>&1; then
    ss -lnt 2>/dev/null | awk '{print $4}' | grep -Eq "(:|\\])${port}$"
    return $?
  fi
  command -v nc >/dev/null 2>&1 && nc -z 127.0.0.1 "$port" >/dev/null 2>&1
}

resolve_genieacs_env_file() {
  local candidate
  for candidate in "$GENIEACS_ENV_FILE" /etc/fakenet-billing-genieacs.env /opt/genieacs/genieacs.env /etc/genieacs.env; do
    [ -n "$candidate" ] && [ -f "$candidate" ] && {
      printf '%s\n' "$candidate"
      return 0
    }
  done
  return 1
}

genieacs_sync_required() {
  local env_file
  [ "${SKIP_GENIEACS_SYNC:-0}" = "1" ] && return 1
  if [ "${GENIEACS_SOURCE:-}" = "disabled" ] || [ "${GENIEACS_ENABLED:-1}" = "0" ]; then
    return 1
  fi
  env_file="$(resolve_genieacs_env_file || true)"
  [ -n "$env_file" ] && return 0
  [ "${FAKENET_BUNDLED_GENIEACS:-0}" = "1" ] && return 0
  port_is_listening "${GENIEACS_NBI_PORT:-7557}"
}

sync_genieacs_virtual_parameters() {
  local attempt bootstrap env_file nbi_port
  if ! genieacs_sync_required; then
    echo "Sinkron Virtual Parameters GenieACS dilewati: integrasi GenieACS tidak aktif."
    return 0
  fi
  bootstrap="$APP_DIR/deploy/genieacs/bootstrap.js"
  [ -f "$bootstrap" ] || {
    echo "ERROR: bootstrap GenieACS tidak ditemukan: $bootstrap" >&2
    return 1
  }
  command -v node >/dev/null 2>&1 || {
    echo "ERROR: Node.js tidak tersedia untuk sinkron Virtual Parameters GenieACS." >&2
    return 1
  }

  env_file="$(resolve_genieacs_env_file || true)"
  [ -n "$env_file" ] || {
    echo "ERROR: integrasi GenieACS aktif tetapi env GenieACS tidak ditemukan." >&2
    return 1
  }

  set -a
  # shellcheck disable=SC1090
  . "$env_file"
  set +a

  nbi_port="${GENIEACS_NBI_PORT:-7557}"
  if ! port_is_listening "$nbi_port"; then
    echo "ERROR: integrasi GenieACS aktif tetapi NBI lokal 127.0.0.1:${nbi_port} belum siap." >&2
    return 1
  fi

  for attempt in 1 2 3; do
    echo "Sinkron Virtual Parameters GenieACS via $env_file (percobaan $attempt/3)"
    if GENIEACS_BOOTSTRAP_EXTERNAL=1 \
      GENIEACS_UI_BOOTSTRAP_ATTEMPTS="${GENIEACS_UI_BOOTSTRAP_ATTEMPTS:-1}" \
      GENIEACS_NBI_BOOTSTRAP_ATTEMPTS="${GENIEACS_NBI_BOOTSTRAP_ATTEMPTS:-6}" \
      GENIEACS_BOOTSTRAP_REQUEST_TIMEOUT_MS="${GENIEACS_BOOTSTRAP_REQUEST_TIMEOUT_MS:-3000}" \
      node "$bootstrap"; then
      echo "Sinkron Virtual Parameters GenieACS berhasil."
      return 0
    fi
    [ "$attempt" -ge 3 ] || sleep 2
  done

  echo "ERROR: sinkron Virtual Parameters GenieACS gagal setelah 3 percobaan; update dihentikan agar parameter tidak tertinggal." >&2
  return 1
}

systemd_unit_exists() {
  systemctl list-unit-files "$1" --no-legend >/dev/null 2>&1
}

cleanup_obsolete_worker_runtime() {
  local backup_dir changed file
  changed=0

  if command -v systemctl >/dev/null 2>&1; then
    backup_dir="$BACKUP_DIR/systemd-obsolete-$(date +%Y%m%d%H%M%S)"

    if systemd_unit_exists fakenet-billing-worker.service; then
      mkdir -p "$backup_dir"
      systemctl stop fakenet-billing-worker.service >/dev/null 2>&1 || true
      systemctl disable fakenet-billing-worker.service >/dev/null 2>&1 || true
      [ ! -f /etc/systemd/system/fakenet-billing-worker.service ] || cp -a /etc/systemd/system/fakenet-billing-worker.service "$backup_dir/" || true
      [ ! -d /etc/systemd/system/fakenet-billing-worker.service.d ] || cp -a /etc/systemd/system/fakenet-billing-worker.service.d "$backup_dir/" || true
      rm -f /etc/systemd/system/fakenet-billing-worker.service
      rm -rf /etc/systemd/system/fakenet-billing-worker.service.d
      changed=1
    fi

    for file in /etc/systemd/system/fakenet-billing.service.d/*.conf; do
      [ -f "$file" ] || continue
      if grep -q 'FAKENET_ENGINE_ROLE' "$file"; then
        mkdir -p "$backup_dir"
        cp -a "$file" "$backup_dir/" || true
        rm -f "$file"
        changed=1
      fi
    done

    if [ "$changed" -eq 1 ]; then
      echo "Runtime worker Whatsapp lama dinonaktifkan; queue berjalan di service utama."
      systemctl daemon-reload >/dev/null 2>&1 || true
      systemctl reset-failed fakenet-billing-worker.service >/dev/null 2>&1 || true
    fi
  fi

}

verify_update_payload() {
  local root="${1:-$APP_DIR}"
  [ -f "$root/deploy/lib/installer-common.sh" ] || { echo "ERROR: helper rilis tidak tersedia." >&2; return 1; }
  . "$root/deploy/lib/installer-common.sh"
  verify_release_payload "$root"
  node "$root/deploy/verify-release.js" "$root"
}

database_url_for_name() {
  local explicit_url="$1" db_name="$2" db_user="$3" db_password="$4"
  if [ -n "$explicit_url" ]; then
    printf '%s\n' "$explicit_url"
    return 0
  fi
  if [ -n "$db_name" ] && [ -n "$db_user" ] && [ -n "$db_password" ]; then
    printf 'postgres://%s:%s@127.0.0.1:5432/%s\n' "$db_user" "$db_password" "$db_name"
  fi
}

dump_database() {
  local label="$1" url="$2" output="$3"
  if [ -z "$url" ]; then
    echo "Lewati dump $label: URL database kosong"
    return 0
  fi
  if ! command -v pg_dump >/dev/null 2>&1; then
    echo "Lewati dump $label: pg_dump tidak tersedia"
    return 0
  fi
  echo "Dump database $label ke $output"
  pg_dump --no-owner --no-privileges --format=custom --file="$output" "$url"
}

write_manifest() {
  local manifest="$1"
  {
    echo "app=fakenet-billing"
    echo "created_at=$(date -Is)"
    echo "app_dir=$APP_DIR"
    echo "source_mode=$([ -d "$APP_DIR/.git" ] && echo git || echo archive)"
    if [ -d "$APP_DIR/.git" ]; then
      echo "git_remote=$(git -C "$APP_DIR" remote get-url origin 2>/dev/null || true)"
      echo "git_branch=$(git -C "$APP_DIR" branch --show-current 2>/dev/null || true)"
      echo "git_commit=$(git -C "$APP_DIR" rev-parse HEAD 2>/dev/null || true)"
      echo "git_status_short_begin"
      git -C "$APP_DIR" status --short --untracked-files=no 2>/dev/null || true
      echo "git_status_short_end"
    fi
    echo "node_version=$(node -v 2>/dev/null || true)"
    echo "npm_version=$(npm -v 2>/dev/null || true)"
  } > "$manifest"
}

safe_copy_if_exists() {
  local source="$1" target_dir="$2"
  if [ -e "$source" ]; then
    mkdir -p "$target_dir"
    cp -a "$source" "$target_dir/"
  fi
}

snapshot_genieacs_configuration() {
  local env_file nbi_port resource target status
  if ! genieacs_sync_required; then
    echo "Lewati snapshot GenieACS: integrasi tidak aktif."
    return 0
  fi
  env_file="$(resolve_genieacs_env_file || true)"
  [ -n "$env_file" ] || {
    echo "Backup dibatalkan: integrasi GenieACS aktif tetapi env GenieACS tidak ditemukan." >&2
    return 1
  }
  set -a
  # shellcheck disable=SC1090
  . "$env_file"
  set +a
  nbi_port="${GENIEACS_NBI_PORT:-7557}"
  if ! curl -fsS --max-time 5 "http://127.0.0.1:${nbi_port}/devices/?limit=1" >/dev/null; then
    echo "Backup dibatalkan: GenieACS NBI 127.0.0.1:${nbi_port} tidak dapat dibaca." >&2
    return 1
  fi
  mkdir -p "$tmp_backup_dir/genieacs"
  for resource in virtualParameters presets provisions config; do
    target="$tmp_backup_dir/genieacs/${resource}.json"
    status="$(curl -sS --max-time 20 -w '%{http_code}' "http://127.0.0.1:${nbi_port}/${resource}" -o "$target")" || return 1
    if [ "$status" = 404 ] && [ "$resource" = config ]; then
      node "$source_stage/deploy/genieacs/snapshot-config.js" "$target" || return 1
    elif [ "$status" != 200 ]; then
      echo "Backup dibatalkan: resource ACS $resource HTTP $status." >&2
      return 1
    fi
    node -e 'const fs=require("fs"); const value=JSON.parse(fs.readFileSync(process.argv[1],"utf8")); if (!Array.isArray(value)) process.exit(1);' "$target" || {
      echo "Backup dibatalkan: respons GenieACS ${resource} bukan JSON array yang valid." >&2
      return 1
    }
  done
  target="$tmp_backup_dir/genieacs/device-virtual-parameters.json"
  curl -fsS --max-time 60 "http://127.0.0.1:${nbi_port}/devices/?projection=_id,VirtualParameters" -o "$target"
  node -e 'const fs=require("fs"); const value=JSON.parse(fs.readFileSync(process.argv[1],"utf8")); if (!Array.isArray(value)) process.exit(1);' "$target" || {
    echo "Backup dibatalkan: snapshot nilai Virtual Parameters perangkat tidak valid." >&2
    return 1
  }
  echo "Snapshot GenieACS selesai: definisi, preset, provision, UI config, dan nilai Virtual Parameters perangkat."
}

create_pre_update_backup() {
  load_env_file

  local stamp backup_file app_db_url radius_db_url
  stamp="$(date +%Y%m%d%H%M%S)"
  backup_file="$BACKUP_DIR/fakenet-billing-pre-update-$stamp.tar.gz"
  tmp_backup_dir="$(mktemp -d)"

  echo "Menyiapkan backup pre-update di $tmp_backup_dir"
  mkdir -p "$tmp_backup_dir/app" "$tmp_backup_dir/etc" "$tmp_backup_dir/db"

  safe_copy_if_exists "$APP_DIR/data" "$tmp_backup_dir/app"
  safe_copy_if_exists "$APP_DIR/.env.example" "$tmp_backup_dir/app"
  safe_copy_if_exists "$APP_DIR/package.json" "$tmp_backup_dir/app"
  safe_copy_if_exists "$APP_DIR/package-lock.json" "$tmp_backup_dir/app"
  safe_copy_if_exists "$APP_DIR/deploy/fakenet-billing.env" "$tmp_backup_dir/app/deploy"
  safe_copy_if_exists "$APP_DIR/deploy/fakenet-billing-waha.env" "$tmp_backup_dir/app/deploy"
  safe_copy_if_exists "$ENV_FILE" "$tmp_backup_dir/etc"
  safe_copy_if_exists "$WAHA_ENV_FILE" "$tmp_backup_dir/etc"
  safe_copy_if_exists "$TURNSTILE_ENV_FILE" "$tmp_backup_dir/etc"
  safe_copy_if_exists "$ISOLIR_CONTEXT_ENV_FILE" "$tmp_backup_dir/etc"
  safe_copy_if_exists "$GENIEACS_ENV_FILE" "$tmp_backup_dir/etc"
  snapshot_genieacs_configuration
  write_manifest "$tmp_backup_dir/manifest.txt"

  app_db_url="$(database_url_for_name "${DATABASE_URL:-${POSTGRES_URL:-}}" "${APP_DATABASE_NAME:-}" "${APP_DATABASE_USER:-}" "${APP_DATABASE_PASSWORD:-}")"
  radius_db_url="$(database_url_for_name "${FREERADIUS_DATABASE_URL:-${FREERADIUS_DB_URL:-}}" "${RADIUS_DATABASE_NAME:-}" "${RADIUS_DATABASE_USER:-}" "${RADIUS_DATABASE_PASSWORD:-}")"
  dump_database app "$app_db_url" "$tmp_backup_dir/db/fakenet_billing.dump"
  dump_database radius "$radius_db_url" "$tmp_backup_dir/db/radius.dump"

  tar -czf "$backup_file" -C "$tmp_backup_dir" .
  chmod 600 "$backup_file"
  rm -rf "$tmp_backup_dir"
  tmp_backup_dir=""
  echo "Backup pre-update selesai: $backup_file"
}

harden_sensitive_permissions
load_env_file

# Refresh update source after backup because /etc/fakenet-billing.env is loaded
# inside create_pre_update_backup(). Older installs can be archive-based without
# .git, so FAKENET_UPDATE_ARCHIVE_URL from the env file must be honored here.
ARCHIVE_URL="${ARCHIVE_URL_OVERRIDE:-${FAKENET_UPDATE_ARCHIVE_URL:-$ARCHIVE_URL}}"
BRANCH="${BRANCH_OVERRIDE:-${FAKENET_UPDATE_BRANCH:-$BRANCH}}"
DOWNLOAD_TIMEOUT_SECONDS="${FAKENET_UPDATE_DOWNLOAD_TIMEOUT_SECONDS:-$DOWNLOAD_TIMEOUT_SECONDS}"
DOWNLOAD_RETRIES="${FAKENET_UPDATE_DOWNLOAD_RETRIES:-$DOWNLOAD_RETRIES}"

run_with_timeout() {
  local seconds="$1"
  shift
  if command -v timeout >/dev/null 2>&1; then
    if timeout --help 2>&1 | grep -q -- '--foreground'; then
      timeout --foreground --signal=TERM --kill-after=30s "$seconds" "$@"
    else
      timeout -s TERM -k 30 "$seconds" "$@"
    fi
  else
    "$@"
  fi
}

install_node_dependencies() {
  local install_status
  dependency_stage="$source_stage"

  echo "Instal dependency di staging (timeout ${NPM_INSTALL_TIMEOUT_SECONDS}s)"
  set +e
  if [ -f "$dependency_stage/package-lock.json" ]; then
    run_with_timeout "$NPM_INSTALL_TIMEOUT_SECONDS" npm ci --prefix "$dependency_stage" --omit=dev --no-audit --no-fund --prefer-offline --fetch-retries=2 --fetch-timeout=60000
  else
    run_with_timeout "$NPM_INSTALL_TIMEOUT_SECONDS" npm install --prefix "$dependency_stage" --omit=dev --no-audit --no-fund --prefer-offline --fetch-retries=2 --fetch-timeout=60000
  fi
  install_status=$?
  set -e
  if [ "$install_status" -eq 124 ] || [ "$install_status" -eq 137 ]; then
    echo "Instal dependency melewati timeout ${NPM_INSTALL_TIMEOUT_SECONDS}s; dependency aktif tidak diubah." >&2
    return 1
  fi
  if [ "$install_status" -ne 0 ]; then
    echo "Instal dependency gagal (exit $install_status); dependency aktif tidak diubah." >&2
    return "$install_status"
  fi

  (cd "$dependency_stage" && node -e "require('bullmq'); require('web-push'); require('sharp')") >/dev/null
  (cd "$dependency_stage" && node -e "const fs=require('fs'),path=require('path'); for(const file of[require.resolve('@xterm/xterm'),require.resolve('@xterm/addon-fit'),path.join(path.dirname(require.resolve('@xterm/xterm')),'../css/xterm.css')])fs.accessSync(file)")
  (cd "$dependency_stage" && node -e "require('node-pty'); const {Terminal}=require('@xterm/headless'); const terminal=new Terminal({cols:80,rows:24,allowProposedApi:true}); terminal.dispose()")
  node "$source_stage/deploy/verify-release.js" "$source_stage" --runtime
  echo "Dependency staging berhasil diverifikasi; dependency aktif belum diubah."
}

download_update_archive() {
  local archive_url="$1" output_file="$2" status
  echo "Download archive update (timeout ${DOWNLOAD_TIMEOUT_SECONDS}s, retry ${DOWNLOAD_RETRIES}x)"
  set +e
  curl -fsSL \
    --connect-timeout 20 \
    --max-time "$DOWNLOAD_TIMEOUT_SECONDS" \
    --retry "$DOWNLOAD_RETRIES" \
    --retry-delay 5 \
    --retry-max-time "$DOWNLOAD_TIMEOUT_SECONDS" \
    "$archive_url" \
    -o "$output_file"
  status=$?
  set -e
  if [ "$status" -ne 0 ]; then
    echo "Download archive update gagal (exit $status). Periksa koneksi server ke GitHub/codeload atau naikkan FAKENET_UPDATE_DOWNLOAD_TIMEOUT_SECONDS." >&2
    return "$status"
  fi
  if [ ! -s "$output_file" ]; then
    echo "Download archive update gagal: file archive kosong." >&2
    return 1
  fi
}

tmpdir="$(mktemp -d "$APP_DIR/.update-source.XXXXXX")"
source_stage="$tmpdir/source"
mkdir -p "$source_stage"
target_commit=""
if [ -d "$APP_DIR/.git" ]; then
  echo "Mengambil source Git ke staging; source aktif tidak diubah."
  BRANCH="${BRANCH:-$(git -C "$APP_DIR" branch --show-current)}"
  git -C "$APP_DIR" check-ref-format --branch "$BRANCH" >/dev/null
  git -C "$APP_DIR" fetch --no-auto-gc origin "refs/heads/$BRANCH"
  target_commit="$(git -C "$APP_DIR" rev-parse FETCH_HEAD)"
  git -C "$APP_DIR" merge-base --is-ancestor HEAD "$target_commit" || {
    echo "ERROR: riwayat Git bercabang; source lokal tidak dipaksa ditimpa." >&2
    exit 1
  }
  git -C "$APP_DIR" archive "$target_commit" | tar -xf - -C "$source_stage"
elif [ -n "$ARCHIVE_URL" ]; then
  echo "Mengambil archive ke staging."
  download_update_archive "$ARCHIVE_URL" "$tmpdir/source.tar.gz"
  tar -tzf "$tmpdir/source.tar.gz" | awk 'BEGIN {ok=1} /^\// || /(^|\/)\.\.(\/|$)/ {ok=0} END {exit !ok}' || {
    echo "ERROR: jalur archive tidak aman." >&2; exit 1;
  }
  tar -xzf "$tmpdir/source.tar.gz" -C "$source_stage" --strip-components=1
else
  echo "ERROR: sumber update Git/archive tidak tersedia." >&2
  exit 1
fi

verify_update_payload "$source_stage"
installation_preflight "$APP_DIR" update "${FAKENET_BUNDLED_GENIEACS:-0}"
create_pre_update_backup
bash "$source_stage/install.sh" node-runtime
install_node_dependencies

rollback_dir="$BACKUP_DIR/activation-$(date +%Y%m%d%H%M%S)-$$"
mkdir -p "$rollback_dir"
mkdir -p "$rollback_dir/systemd"
for file in "$APP_DIR"/deploy/systemd/*.service "$APP_DIR"/deploy/systemd/*.target; do
  unit="$(basename "$file")"
  [ ! -f "/etc/systemd/system/$unit" ] || cp -a "/etc/systemd/system/$unit" "$rollback_dir/systemd/"
done
queue_state="$rollback_dir/queue.json"
node "$source_stage/deploy/queue-guard.js" pause "$APP_DIR" "$queue_state"
for unit in fakenet-billing fakenet-billing-isolir fakenet-billing-voucher fakenet-billing-wifiku fakenet-billing-radius-connector; do
  if systemctl is-active --quiet "$unit.service"; then active_units+=("$unit.service"); fi
done
[ "${#active_units[@]}" -gt 0 ] || { echo "ERROR: tidak ada service Billing aktif untuk diupdate." >&2; exit 1; }
systemctl stop "${active_units[@]}"
activation_started=1
node "$source_stage/deploy/activate-release.js" activate "$APP_DIR" "$source_stage" "$rollback_dir"
cd "$APP_DIR"
node "$APP_DIR/deploy/verify-release.js" "$APP_DIR" --runtime

load_env_file
INSTALL_GENIEACS_FOR_REPAIR=0
if [ "${FAKENET_BUNDLED_GENIEACS:-0}" = 1 ] && [ -f "$GENIEACS_ENV_FILE" ]; then INSTALL_GENIEACS_FOR_REPAIR=1; fi
APP_DIR="$APP_DIR" REPAIR_FREERADIUS=0 SKIP_GENIEACS_SYNC=1 SKIP_GENIEACS_RUNTIME_RESTART=1 \
  GENIEACS_BOOTSTRAP_EXTERNAL=1 INSTALL_GENIEACS="$INSTALL_GENIEACS_FOR_REPAIR" bash "$APP_DIR/install.sh" repair
sync_genieacs_virtual_parameters
cleanup_obsolete_worker_runtime

systemctl daemon-reload
systemctl start "${active_units[@]}"
load_env_file
if [ -f "$GENIEACS_ENV_FILE" ]; then set -a; . "$GENIEACS_ENV_FILE"; set +a; fi
verify_runtime_health "$APP_DIR"
node "$source_stage/deploy/activate-release.js" commit "$APP_DIR" "$rollback_dir" "$target_commit"
activation_started=0
dependency_stage=""
if [ -f "$queue_state" ]; then
  node "$source_stage/deploy/queue-guard.js" resume "$APP_DIR" "$queue_state" || {
    echo "ERROR: runtime baru sehat, tetapi antrean WA belum berhasil dipulihkan." >&2
    exit 1
  }
fi
queue_state=""
echo "Update selesai. Seluruh komponen lulus pemeriksaan. Backup: $rollback_dir"
